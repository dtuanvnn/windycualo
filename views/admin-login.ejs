<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập quản trị - Windy Hotel</title>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Be Vietnam Pro', sans-serif; background-color: #F8F0E8; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
    .login-card { background: white; padding: 40px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); width: 100%; max-width: 360px; border: 1px solid rgba(201,146,43,0.2); text-align: center; }
    h2 { color: #1A0A0A; margin-bottom: 24px; font-size: 1.5rem; }
    input[type="password"] { width: 100%; padding: 12px; margin-bottom: 16px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-size: 1rem; }
    input[type="password"]:focus { border-color: #C9922B; outline: none; }
    button { width: 100%; padding: 12px; background-color: #C9922B; color: white; border: none; border-radius: 4px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: 0.2s; }
    button:hover { background-color: #9A6A18; }
    .error-msg { color: #D32F2F; font-size: 0.9rem; margin-bottom: 16px; text-align: left; }
  </style>
</head>
<body>

  <div class="login-card">
    <h2>HỆ THỐNG QUẢN TRỊ<br><span style="color:#C9922B; font-size:1.1rem;">WINDY HOTEL</span></h2>
    
    <% if (error) { %>
      <div class="error-msg">⚠️ <%= error %></div>
    <% } %>

    <form action="/admin/login" method="POST">
      <input type="password" name="password" placeholder="Nhập mật khẩu truy cập" required autofocus>
      <button type="submit">Đăng Nhập</button>
    </form>
  </div>

</body>
</html>