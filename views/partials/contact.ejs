<section id="contact" class="section-padding">
  <div class="container">
    <div class="text-center">
      <h3 class="section-subtitle" data-vi="LIÊN HỆ" data-en="CONTACT US">LIÊN HỆ</h3>
      <h2 class="section-title" data-vi="Kết Nối Với Chúng Tôi" data-en="Get In Touch Ready">Kết Nối Với Chúng Tôi</h2>
      <div class="divider"></div>
    </div>
    <div class="contact-wrapper">
      <div class="contact-info">
        <h4 data-vi="Thông Tin Khách Sạn" data-en="Hotel Contact Info">Thông Tin Khách Sạn</h4>
        <p><strong>Windy Hotel Cua Lo</strong></p>
        <p data-vi="📍 Vị trí: Đường Bình Minh, Phường Nghi Hương, Thị xã Cửa Lò, Nghệ An" data-en="📍 Address: Binh Minh Street, Nghi Huong Ward, Cua Lo Beach, Nghe An">📍 Vị trí: Đường Bình Minh, Phường Nghi Hương, Thị xã Cửa Lò, Nghệ An</p>
        <p>📞 Hotline: 0912.xxx.xxx</p>
        <p>✉️ Email: info@windyhotelcualo.vn</p>
      </div>
      <div class="contact-form">
        <form onsubmit="alert('Cảm ơn bạn đã gửi liên hệ!'); return false;">
          <input type="text" data-vi="Họ và tên" data-en="Your Name" placeholder="Họ và tên" required>
          <input type="email" placeholder="Email Address" required>
          <textarea rows="4" data-vi="Lời nhắn của bạn..." data-en="Your Message..." placeholder="Lời nhắn của bạn..." required></textarea>
          <button type="submit" class="btn-submit-booking" data-vi="Gửi Lời Nhắn" data-en="Send Message">Gửi Lời Nhắn</button>
        </form>
      </div>
    </div>
  </div>
</section>