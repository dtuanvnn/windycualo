<section id="rooms" class="section-padding bg-light">
  <div class="container">
    <div class="text-center">
      <h3 class="section-subtitle" data-vi="KHÔNG GIAN NGHỈ DƯỠNG" data-en="ACCOMMODATIONS">KHÔNG GIAN NGHỈ DƯỠNG</h3>
      <h2 class="section-title" data-vi="Hạng Phòng Sang Trọng Tại Windy Cửa Lò" data-en="Our Premium Rooms at Windy Cua Lo">Hạng Phòng Sang Trọng Tại Windy Cửa Lò</h2>
      <div class="divider"></div>
    </div>
    <div class="rooms-grid">
      <div class="room-card">
        <div class="room-img" style="background-image: url('https://cdn.windycualo.com/images/standard/1.jpg')"></div>
        <div class="room-info">
          <h3 data-vi="Phòng Standard Tiêu Chuẩn" data-en="Standard Cozy Room">Phòng Standard Tiêu Chuẩn</h3>
          <p data-vi="Diện tích 25m², đầy đủ trang thiết bị thông minh hiện đại, view thành phố." data-en="25m², fully dynamic amenities with cooling city view.">Diện tích 25m², đầy đủ trang thiết bị thông minh hiện đại, view thành phố.</p>
          <span class="room-price" data-vi="Từ <%= (roomPrices && roomPrices['Standard'] ? roomPrices['Standard'].toLocaleString('vi-VN') : '800.000') %> VNĐ / Đêm" data-en="From <%= (roomPrices && roomPrices['Standard'] ? roomPrices['Standard'].toLocaleString('vi-VN') : '800,000') %> VND / Night">Từ <%= (roomPrices && roomPrices['Standard'] ? roomPrices['Standard'].toLocaleString('vi-VN') : '800.000') %> VNĐ / Đêm</span>
        </div>
      </div>
      <div class="room-card">
        <div class="room-img" style="background-image: url('https://cdn.windycualo.com/images/deluxe/1.jpg')"></div>
        <div class="room-info">
          <h3 data-vi="Phòng Deluxe Hướng Biển" data-en="Deluxe Ocean View">Phòng Deluxe Hướng Biển</h3>
          <p data-vi="Diện tích 35m², ban công riêng rộng mở đón gió khơi xa trọn vẹn bãi biển Cửa Lò." data-en="35m², exclusive balcony optimized for beautiful ocean breeze watching.">Diện tích 35m², ban công riêng rộng mở đón gió khơi xa trọn vẹn bãi biển Cửa Lò.</p>
          <span class="room-price" data-vi="Từ <%= (roomPrices && roomPrices['Deluxe'] ? roomPrices['Deluxe'].toLocaleString('vi-VN') : '1.500.000') %> VNĐ / Đêm" data-en="From <%= (roomPrices && roomPrices['Deluxe'] ? roomPrices['Deluxe'].toLocaleString('vi-VN') : '1,500,000') %> VND / Night">Từ <%= (roomPrices && roomPrices['Deluxe'] ? roomPrices['Deluxe'].toLocaleString('vi-VN') : '1.500.000') %> VNĐ / Đêm</span>
        </div>
      </div>
      <div class="room-card">
        <div class="room-img" style="background-image: url('https://cdn.windycualo.com/images/family/2.jpg')"></div>
        <div class="room-info">
          <h3 data-vi="Phòng Family Hướng Biển Panorama" data-en="Family Ocean View Panorama">Phòng Family Hướng Biển Panorama</h3>
          <p data-vi="Diện tích 45m², ban công riêng rộng mở đón gió khơi xa trọn vẹn bãi biển Cửa Lò." data-en="45m², exclusive balcony optimized for beautiful ocean breeze watching.">Diện tích 45m², ban công riêng rộng mở đón gió khơi xa trọn vẹn bãi biển Cửa Lò.</p>
          <span class="room-price" data-vi="Từ <%= (roomPrices && roomPrices['Family'] ? roomPrices['Family'].toLocaleString('vi-VN') : '2.000.000') %> VNĐ / Đêm" data-en="From <%= (roomPrices && roomPrices['Family'] ? roomPrices['Family'].toLocaleString('vi-VN') : '2,000,000') %> VND / Night">Từ <%= (roomPrices && roomPrices['Family'] ? roomPrices['Family'].toLocaleString('vi-VN') : '2.000.000') %> VNĐ / Đêm</span>
        </div>
      </div>
    </div>
  </div>
</section>