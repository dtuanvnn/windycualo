<section class="booking-bar">
  <form id="bookingForm" onsubmit="handleBooking(event)">
    
    <div class="form-group">
      <label data-vi="Họ và Tên" data-en="Full Name">Họ và Tên</label>
      <input type="text" id="custName" required data-vi="Nhập họ tên" data-en="Your name" placeholder="Nhập họ tên">
    </div>

    <div class="form-group">
      <label data-vi="Số Điện Thoại" data-en="Phone Number">Số Điện Thoại</label>
      <input type="tel" id="custPhone" required placeholder="0912xxxxxx">
    </div>

    <div class="form-group">
      <label data-vi="Ngày Đến" data-en="Check-In">Ngày Đến</label>
      <input type="date" id="checkin" required>
    </div>

    <div class="form-group">
      <label data-vi="Ngày Đi" data-en="Check-Out">Ngày Đi</label>
      <input type="date" id="checkout" required>
    </div>

    <div class="form-group">
      <label data-vi="Loại Phòng" data-en="Room Type">Loại Phòng</label>
      <select id="roomType">
        <option value="Standard" data-vi="Phòng Tiêu Chuẩn" data-en="Standard Cozy">Phòng Tiêu Chuẩn</option>
        <option value="Deluxe" data-vi="Phòng Deluxe Hướng Biển" data-en="Deluxe Ocean View">Phòng Deluxe Hướng Biển</option>
      </select>
    </div>

    <div class="form-group">
      <button type="submit" class="btn-submit-booking" data-vi="Đặt Phòng Ngay" data-en="Book Now">Đặt Phòng Ngay</button>
    </div>
  </form>
</section>