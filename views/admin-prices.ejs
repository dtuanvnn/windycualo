<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bảng Giá Phòng - Windy Hotel Cửa Lò</title>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Be Vietnam Pro', sans-serif; margin: 0; padding: 20px; background-color: #FAFAF8; color: #2C1A0A; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 2px solid #C9922B; padding-bottom: 15px; }
    h1 { margin: 0; color: #1A0A0A; font-size: 1.8rem; }
    .header-actions { display: flex; align-items: center; gap: 12px; }
    .nav-link { padding: 8px 16px; color: #C9922B; text-decoration: none; border-radius: 4px; font-size: 0.9rem; font-weight: 500; border: 1px solid #C9922B; }
    .nav-link:hover { background-color: #C9922B; color: white; }
    .nav-link.active { background-color: #C9922B; color: white; }
    .btn-logout { padding: 8px 16px; background-color: #8B1A1A; color: white; text-decoration: none; border-radius: 4px; font-size: 0.9rem; font-weight: 500; }
    .btn-logout:hover { background-color: #C0392B; }

    .add-form { background: white; border-radius: 8px; padding: 20px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid rgba(201,146,43,0.15); }
    .add-form h2 { margin: 0 0 16px; font-size: 1.2rem; color: #1A0A0A; }
    .form-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
    .form-group { display: flex; flex-direction: column; gap: 4px; }
    .form-group label { font-size: 0.85rem; font-weight: 600; color: #555; }
    .form-group input, .form-group select { padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 0.9rem; font-family: inherit; }
    .btn-add { padding: 8px 20px; background-color: #28a745; color: white; border: none; border-radius: 4px; font-size: 0.9rem; font-weight: 600; cursor: pointer; font-family: inherit; }
    .btn-add:hover { background-color: #218838; }
    .btn-cancel { padding: 8px 20px; background-color: #6c757d; color: white; border: none; border-radius: 4px; font-size: 0.9rem; font-weight: 600; cursor: pointer; font-family: inherit; display: none; }
    .btn-cancel:hover { background-color: #5a6268; }
    .holiday-fields { display: none; }
    .holiday-fields.show { display: contents; }

    .table-container { background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); overflow-x: auto; border: 1px solid rgba(201,146,43,0.15); }
    table { width: 100%; border-collapse: collapse; text-align: left; min-width: 800px; }
    th { background-color: #F8F0E8; color: #1A0A0A; padding: 14px; font-weight: 600; border-bottom: 2px solid rgba(201,146,43,0.2); }
    td { padding: 14px; border-bottom: 1px solid #eee; font-size: 0.95rem; }
    tr:hover { background-color: #FAF6F0; }

    .badge { padding: 4px 10px; border-radius: 20px; font-weight: bold; font-size: 12px; display: inline-block; }
    .badge-normal { background-color: #d4edda; color: #155724; }
    .badge-weekend { background-color: #cce5ff; color: #004085; }
    .badge-holiday { background-color: #f8d7da; color: #721c24; }

    .action-group { display: flex; gap: 6px; flex-wrap: wrap; }
    .btn-sm { padding: 4px 10px; border: none; border-radius: 4px; font-size: 0.8rem; font-weight: 600; cursor: pointer; font-family: inherit; }
    .btn-edit { background-color: #C9922B; color: white; }
    .btn-edit:hover { background-color: #a87820; }
    .btn-delete { background-color: #dc3545; color: white; }
    .btn-delete:hover { background-color: #c82333; }

    .no-data { text-align: center; padding: 40px; color: #888; font-style: italic; }

    .info-box { background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 14px 18px; margin-bottom: 20px; font-size: 0.9rem; color: #856404; }
  </style>
</head>
<body>

  <div class="header">
    <h1>Bảng Giá Phòng Khách Sạn</h1>
    <div class="header-actions">
      <a href="/admin/bookings" class="nav-link">Đặt phòng</a>
      <a href="/admin/rooms" class="nav-link">Quản lý phòng</a>
      <a href="/admin/room-map" class="nav-link">Sơ đồ phòng</a>
      <a href="/admin/room-calendar" class="nav-link">Lịch phòng</a>
      <a href="/admin/prices" class="nav-link active">Bảng giá</a>
      <a href="/admin/customers" class="nav-link">Khách hàng</a>
      <a href="/admin/logout" class="btn-logout">Đăng xuất</a>
    </div>
  </div>

  <div class="info-box">
    Ưu tiên áp dụng giá: <strong>Ngày lễ</strong> > <strong>Cuối tuần (T7, CN)</strong> > <strong>Thường ngày</strong> > Giá mặc định trên phòng.
  </div>

  <div class="add-form">
    <h2 id="formTitle">Thêm quy tắc giá</h2>
    <input type="hidden" id="formEditId" value="">
    <div class="form-row">
      <div class="form-group">
        <label>Loại phòng</label>
        <select id="formRoomName">
          <option value="Standard">Standard</option>
          <option value="Deluxe">Deluxe</option>
          <option value="Family">Family</option>
          <option value="Suite">Suite</option>
        </select>
      </div>
      <div class="form-group">
        <label>Loại giá</label>
        <select id="formTierType" onchange="toggleHolidayFields()">
          <option value="normal">Thường ngày</option>
          <option value="weekend">Cuối tuần (T7, CN)</option>
          <option value="holiday">Ngày lễ / Sự kiện</option>
        </select>
      </div>
      <div class="form-group">
        <label>Giá / đêm (VNĐ)</label>
        <input type="number" id="formPrice" min="0" step="10000" placeholder="500000">
      </div>
      <div class="holiday-fields" id="holidayFields">
        <div class="form-group">
          <label>Tên dịp lễ</label>
          <input type="text" id="formHolidayName" placeholder="VD: Tết Nguyên Đán">
        </div>
        <div class="form-group">
          <label>Ngày bắt đầu</label>
          <input type="date" id="formStartDate">
        </div>
        <div class="form-group">
          <label>Ngày kết thúc</label>
          <input type="date" id="formEndDate">
        </div>
      </div>
      <button class="btn-add" onclick="handleSavePrice()">Lưu</button>
      <button class="btn-cancel" id="btnCancel" onclick="handleCancelEdit()">Hủy</button>
    </div>
  </div>

  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Loại phòng</th>
          <th>Loại giá</th>
          <th>Giá / đêm</th>
          <th>Tên dịp lễ</th>
          <th>Thời gian áp dụng</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (prices.length === 0) { %>
          <tr>
            <td colspan="6" class="no-data">Chưa có quy tắc giá nào.</td>
          </tr>
        <% } else { %>
          <% prices.forEach(p => { %>
            <tr>
              <td><strong><%= p.roomName %></strong></td>
              <td>
                <% if (p.tierType === 'normal') { %>
                  <span class="badge badge-normal">Thường ngày</span>
                <% } else if (p.tierType === 'weekend') { %>
                  <span class="badge badge-weekend">Cuối tuần</span>
                <% } else { %>
                  <span class="badge badge-holiday">Ngày lễ</span>
                <% } %>
              </td>
              <td><%= p.price.toLocaleString('vi-VN') %> VNĐ</td>
              <td><%= p.holidayName || '—' %></td>
              <td>
                <% if (p.startDate && p.endDate) { %>
                  <%= new Date(p.startDate).toLocaleDateString('vi-VN') %> — <%= new Date(p.endDate).toLocaleDateString('vi-VN') %>
                <% } else { %>
                  —
                <% } %>
              </td>
              <td>
                <div class="action-group">
                  <button class="btn-sm btn-edit" onclick="handleEditPrice('<%= p._id %>', '<%= p.roomName %>', '<%= p.tierType %>', <%= p.price %>, '<%= p.holidayName || '' %>', '<%= p.startDate ? new Date(p.startDate).toISOString().split('T')[0] : '' %>', '<%= p.endDate ? new Date(p.endDate).toISOString().split('T')[0] : '' %>')">Sửa</button>
                  <button class="btn-sm btn-delete" onclick="handleDeletePrice('<%= p._id %>')">Xóa</button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

<script src="/js/main-admin-prices.js"></script>
</body>
</html>
